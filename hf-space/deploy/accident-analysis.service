[Unit]
Description=Accident Analysis Platform API
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=sensorflow
WorkingDirectory=/opt/sensorflow/analysis
ExecStart=/opt/sensorflow/analysis/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002 --workers 4
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
